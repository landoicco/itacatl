# Copied to backend.tf once the state bucket exists, to move this stack's state into it
# (runbook in docs/terraform.md). The bucket's name contains the account ID and its region is a
# variable, so both come from backend.hcl (git-ignored) with -backend-config=backend.hcl.
terraform {
  backend "s3" {
    key          = "bootstrap/terraform.tfstate"
    encrypt      = true
    use_lockfile = true
  }
}
