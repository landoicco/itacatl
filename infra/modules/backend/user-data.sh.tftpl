#!/bin/bash
# Runs once, as root, on the instance's first boot. Its output goes to
# /var/log/cloud-init-output.log, readable through Session Manager.
set -euo pipefail

region="${region}"

token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
instance_id=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" \
  http://169.254.169.254/latest/meta-data/instance-id)

# The group keeps the instance pending until this reports on its launch hook: CONTINUE puts it in
# service, ABANDON has it terminated and replaced
report() {
  aws autoscaling complete-lifecycle-action --region "$region" \
    --auto-scaling-group-name "${autoscaling_group}" --lifecycle-hook-name "${lifecycle_hook}" \
    --instance-id "$instance_id" --lifecycle-action-result "$1"
}
# Any failed step abandons the instance at once, instead of waiting for the hook's timeout
trap 'status=$?; if [ "$status" -ne 0 ]; then report ABANDON || true; fi' EXIT

dnf install -y docker
systemctl enable --now docker

# Memory and disk, which EC2 does not report. Only what the alarms use, since each metric bills
# beyond CloudWatch's free ten. No host dimension: every instance the group launches writes to the
# same series, so the alarms outlive a replacement. The disk is also aggregated by path alone, so
# its alarm does not depend on the file system's type. Optional: a failure is only logged, so
# monitoring never keeps the app from serving
start_agent() {
  dnf install -y amazon-cloudwatch-agent || return
  cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF' || return
{
  "agent": { "metrics_collection_interval": 60, "omit_hostname": true },
  "metrics": {
    "namespace": "${metrics_namespace}",
    "aggregation_dimensions": [["path"]],
    "metrics_collected": {
      "mem": { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true }
    }
  }
}
EOF
  amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s \
    -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
}
# Called as `start_agent || warn_no_agent`, where set -e does not apply, so each step that can
# fail returns on its own
warn_no_agent() {
  echo "The CloudWatch agent did not start; no memory or disk metrics" >&2
}

# The tag a deploy wrote. "none" until the first deploy: the instance goes into service without
# the app, so the first apply does not replace it again and again
tag=$(aws ssm get-parameter --region "$region" --name "${image_tag_parameter}" \
  --query Parameter.Value --output text)
if [ "$tag" = none ]; then
  echo "No image deployed yet; the first deploy replaces this instance"
  start_agent || warn_no_agent
  report CONTINUE
  exit 0
fi

aws ecr get-login-password --region "$region" |
  docker login --username AWS --password-stdin "${registry}"

# 1.5 GB for the container, so the JVM's heap (75% of it, see the Dockerfile) leaves room on a
# 2 GB instance for the system, Docker and the SSM agent. Nothing here is a secret: the app reads
# its credentials with the instance's role.
docker run --detach --name backend --restart unless-stopped \
  --memory 1536m \
  --publish ${app_port}:${app_port} \
  --log-driver awslogs \
  --log-opt awslogs-region="$region" \
  --log-opt awslogs-group="${log_group}" \
  --log-opt awslogs-stream="$instance_id" \
  --env SPRING_PROFILES_ACTIVE=aws \
  --env AWS_REGION="$region" \
  --env DB_HOST="${database_host}" \
  --env DB_NAME="${database_name}" \
  --env DB_MASTER_SECRET_ARN="${master_secret_arn}" \
  "${repository_url}:$tag"

# While the app boots, so the agent adds nothing to a deploy's time without the backend
start_agent || warn_no_agent

# Once in service, the group sees only EC2's status checks, which pass while a hung app does not
# answer. Docker restarts the container if it exits; for one that hangs, a timer checks the app
# every minute and, after five failures in a row, which leave room for a restart, reports the
# instance unhealthy so the group replaces it. It checks liveness, which leaves the database out:
# a database outage is not fixed by replacing the backend
install_watchdog() {
  cat >/etc/backend-watchdog.env <<EOF
REGION=$region
INSTANCE_ID=$instance_id
HEALTH_URL=http://localhost:${app_port}/actuator/health/liveness
EOF

  cat >/usr/local/bin/backend-watchdog <<'EOF'
#!/bin/bash
set -uo pipefail
failures_file=/run/backend-watchdog-failures
if curl -fsS --max-time 10 "$HEALTH_URL" >/dev/null; then
  echo 0 >"$failures_file"
  exit 0
fi
failures=$(($(cat "$failures_file" 2>/dev/null || echo 0) + 1))
echo "$failures" >"$failures_file"
echo "The backend did not answer its health check ($failures in a row)" >&2
if [ "$failures" -ge 5 ]; then
  aws autoscaling set-instance-health --region "$REGION" --instance-id "$INSTANCE_ID" \
    --health-status Unhealthy --no-should-respect-grace-period
fi
EOF
  chmod 755 /usr/local/bin/backend-watchdog

  cat >/etc/systemd/system/backend-watchdog.service <<'EOF'
[Unit]
Description=Report the instance unhealthy when the backend stops answering

[Service]
Type=oneshot
EnvironmentFile=/etc/backend-watchdog.env
ExecStart=/usr/local/bin/backend-watchdog
EOF

  cat >/etc/systemd/system/backend-watchdog.timer <<'EOF'
[Unit]
Description=Check the backend every minute

[Timer]
OnActiveSec=1min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
EOF

  systemctl daemon-reload
  systemctl enable --now backend-watchdog.timer
}

# Take the address and go into service only once the app answers, so a replacement launched while
# the old instance still runs takes its traffic only when it can serve it. Flyway runs before the
# app answers, which can take a few minutes on a new database. Ten minutes, within the hook's 15.
for _ in $(seq 60); do
  if curl -fsS "http://localhost:${app_port}/actuator/health" >/dev/null; then
    aws ec2 associate-address --region "$region" --allocation-id "${allocation_id}" \
      --instance-id "$instance_id" --allow-reassociation
    # Before reporting, so an instance whose watchdog fails to install is abandoned instead of
    # serving without it
    install_watchdog
    report CONTINUE
    exit 0
  fi
  sleep 10
done

echo "The backend did not become healthy in 10 minutes; abandoning the instance" >&2
exit 1
