# Copy to .env (`cp .env.example .env`) before running `docker compose up`.
# .env is git-ignored: put real secrets only there, never in this file.

# Backend
BACKEND_BASE_URL=http://localhost:8080
BACKEND_ACTUATOR_URL=${BACKEND_BASE_URL}/actuator/health
BACKEND_HEALTHCHECK_CMD="wget -qO- ${BACKEND_ACTUATOR_URL} | grep UP || exit 1"
# Database
DB_URL=jdbc:postgresql://database:5432/itacatl
# Owner of the tables, used by Flyway only
DB_USER=itacatl
DB_PASSWORD=change-me
DB_NAME=itacatl
# Password of itacatl_app, the role the backend connects as (subject to Row-Level Security)
DB_APP_PASSWORD=change-me-too
